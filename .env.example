# NEVER COMMIT THE REAL BOT TOKEN
BOT_TOKEN=replace-me
PUBLIC_URL=https://your-app.up.railway.app
TELEGRAM_WEBHOOK_SECRET=choose-a-long-random-string
DATABASE_URL=sqlite:///./zombo.db
ADMIN_IDS=123456789
DEMO_MODE=0
# Keep enabled while pre-0.8.2 Stars invoice links may still be paid.
# Set to 0 only after the operator has retired/reconciled old links.
ACCEPT_LEGACY_STAR_INVOICES=1

# Territory wars use this time zone (IANA)
WAR_TIMEZONE=Europe/Moscow

# Separate Railway zombo-backup service ONLY (never expose in Mini App):
# DATABASE_URL=<Postgres reference>
# S3_ENDPOINT=<Bucket.ENDPOINT reference>
# S3_BUCKET=<Bucket.BUCKET reference>
# S3_REGION=<Bucket.REGION reference>
# S3_ACCESS_KEY_ID=<Bucket.ACCESS_KEY_ID reference>
# S3_SECRET_ACCESS_KEY=<Bucket.SECRET_ACCESS_KEY reference>
# BACKUP_RETENTION_DAYS=30
